// VIP Craft 4 – Datenbankschema (SQLite via Prisma 7 + better-sqlite3 Adapter)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) Modelle – siehe https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // VIP Craft spezifisch
  minecraftName String?  @unique
  twitchName    String?  @unique
  whitelisted   Boolean  @default(false)
  role          String   @default("PLAYER") // PLAYER | MODERATOR | ADMIN, siehe lib/roles.ts

  /// Ist der Account im Discord-Server? Geprüft über den OAuth-Scope
  /// guilds.members.read, siehe lib/discord.ts
  discordJoined    Boolean   @default(false)
  discordCheckedAt DateTime?

  /// Wann der Modpack-Link geklickt wurde. Mehr laesst sich von hier aus nicht
  /// wissen - ob die Datei wirklich ankam, sieht nur der Rechner davor.
  modpackDownloadedAt DateTime?

  /// Ergebnis der letzten Mojang-Pruefung des gespeicherten Namens.
  /// null = noch nie geprueft (etwa bei Namen von vor der Pruefung).
  minecraftNameValid     Boolean?
  minecraftNameCheckedAt DateTime?

  /// UUID des Minecraft-Kontos, faellt bei der Mojang-Pruefung ohnehin ab.
  /// Damit bleibt der Chatverlauf einem Account auch nach einer Namensaenderung
  /// zugeordnet. Bewusst ohne @unique: Eine Kollision waere ein Datenfehler,
  /// soll aber nicht mitten im Speichern eines Profils hochgehen.
  minecraftUuid String?

  /// Freigeschaltet, aber der Serverbefehl steht noch aus - der Server war
  /// offline. Wird nachgeholt, sobald er wieder laeuft (lib/whitelist-queue.ts).
  whitelistPending Boolean @default(false)

  /// Vom Team voruebergehend von der Server-Whitelist genommen. `whitelisted`
  /// bleibt dabei true, sonst wuesste niemand mehr, wer zurueckdarf.
  whitelistSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  suggestions         Suggestion[]
  votes               Vote[]
  applications        WhitelistApplication[] @relation("Applicant")
  reviewedApplications WhitelistApplication[] @relation("Reviewer")
  shops               Shop[]
  shopRatings         ShopRating[]
  gameLogs            GameLog[]
  salaryClaims        SalaryClaim[]
  bounties            Bounty[]
}

// ---------------------------------------------------------------------------
// Kopfgelder
//
// Wer ein Kopfgeld aussetzt, ZAHLT SOFORT: Der Betrag wird beim Anlegen vom
// Numismatics-Konto abgebucht (bounty.js im Spiel). Erst wenn die Abbuchung
// quittiert ist, geht die Zeile auf OPEN - sonst stuende hier ein Kopfgeld,
// fuer das nie jemand bezahlt hat.
//
// Ausgezahlt wird an den, der das Ziel als Naechstes erledigt. Die Grundlage
// dafuer sind die DEATH-Zeilen im GameLog, also dieselbe Quelle wie die
// PvP-Uebersicht - deshalb steht in claimedSeq die ausloesende Zeile: Wer
// wissen will, warum jemand das Geld bekommen hat, findet dort den Satz.
//
// Der Status ist die Sperre gegen Doppelauszahlung: Der Wechsel OPEN -> PAYING
// laeuft als bedingtes UPDATE, das nur einmal greifen kann.
// ---------------------------------------------------------------------------

model Bounty {
  id String @id @default(cuid())

  /// Wer ausgesetzt hat.
  placerId String
  placer   User   @relation(fields: [placerId], references: [id], onDelete: Cascade)

  /// Minecraft-Konto des Ausschreibers, festgehalten wie beim Gehalt: Die
  /// Verknuepfung am Account kann sich aendern, der Beleg soll bleiben.
  placerName String
  placerUuid String

  /// Auf wen. Der Name ist der Schluessel zum Spielprotokoll (dort stehen
  /// keine UUIDs bei Todesmeldungen), die UUID die verlaessliche Identitaet.
  targetName String
  targetUuid String?

  /// Ausgesetzter Betrag in Spurs (siehe lib/currency.ts).
  spurs Int

  /// PENDING | OPEN | PAYING | CLAIMED | EXPIRED, siehe lib/bounty-types.ts
  status String @default("PENDING")

  /// Optionales Ende. null = laeuft, bis es jemand holt.
  expiresAt DateTime?

  /// Freiwillige Begruendung des Ausschreibers. Steht oeffentlich auf der
  /// Website und geht als Chatzeile an alle - deshalb laeuft sie vorher durch
  /// die Pruefung in lib/schimpfwoerter.ts.
  reason String?

  /// Wer kassiert hat.
  claimedByName String?
  claimedByUuid String?
  claimedAt     DateTime?
  /// GameLog-Zeile (seq), die die Auszahlung ausgeloest hat.
  claimedSeq Int?

  /// Warum die Zeile so steht, wie sie steht - fuer den Fall, dass eine
  /// Abbuchung oder Auszahlung nicht durchging.
  note String?

  /// Fehlgeschlagene Buchungsversuche und wann der letzte war.
  ///
  /// Ohne die beiden liefe eine dauerhaft scheiternde Auszahlung in eine
  /// Endlosschleife: Sie faellt auf OPEN zurueck und wird beim naechsten
  /// Statusabruf sofort wieder versucht - alle paar Sekunden ein Befehl an die
  /// Server-Konsole. Damit waechst der Abstand stattdessen (siehe naechsterVersuch
  /// in lib/bounties.ts), und aufgegeben wird nie: Das Geld liegt beim Server,
  /// es muss irgendwann ankommen.
  attempts  Int       @default(0)
  lastTryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetName])
  @@index([placerId])
}

// ---------------------------------------------------------------------------
// Flugzeit und Flugstrecke
//
// Das KubeJS-Skript (flight-log.js) zaehlt je Serverlauf mit und schreibt den
// Stand in eine Datei. Gespeichert wird hier PRO LAUF, nicht als eine grosse
// Summe: Die Datei kennt immer nur den laufenden Serverlauf, ein Neustart
// setzt sie auf null. Waere hier eine Gesamtsumme, muesste jemand Deltas
// ausrechnen - und jeder verpasste oder doppelte Abruf verfaelschte sie.
//
// So ist das Abholen stattdessen wiederholbar: Dieselbe Zeile wird einfach
// ueberschrieben, und die Gesamtsumme ist die Summe ueber alle Laeufe.
// ---------------------------------------------------------------------------

model FlightStat {
  id String @id @default(cuid())

  /// Serverlauf, aus dem die Zahlen stammen.
  runId String
  /// Minecraft-UUID mit Bindestrichen, wie im Spiel.
  uuid String
  /// Name zum Zeitpunkt des Laufs - fuer die Anzeige, wenn kein Account verknuepft ist.
  name String

  seconds Int
  /// Waagerecht zurueckgelegte Strecke in Metern (Bloecken).
  meters Int

  updatedAt DateTime @updatedAt

  @@unique([runId, uuid])
  @@index([uuid])
}

// ---------------------------------------------------------------------------
// Termine
//
// Bis hierher standen die Termine fest im Code (lib/event-types.ts). Die
// Eintraege von dort bleiben bestehen - sie haben uebersetzte Texte in den
// Sprachdateien -, neue kommen aus dieser Tabelle und werden dazugemischt.
//
// Zeiten stehen als echter Zeitpunkt drin (UTC). Eingegeben wird im
// Kontrollraum nach der Uhr in Europe/Berlin, umgerechnet wird beim Speichern,
// siehe lib/zeit.ts.
// ---------------------------------------------------------------------------

model Event {
  id String @id @default(cuid())

  title       String
  description String

  /// Englische Fassung, freiwillig. Leer heisst: Auf der englischen Seite
  /// steht derselbe Text wie auf der deutschen - besser als eine Luecke.
  titleEn       String?
  descriptionEn String?

  start DateTime
  end   DateTime?

  location String
  host     String

  /// race | contest | boss | workshop | meeting | party, siehe event-types.ts
  type String

  /// Treibt den Countdown auf der Startseite. Sind mehrere angehakt, gewinnt
  /// der naechste - so laesst sich der uebernaechste Termin schon vorbereiten.
  countdown Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([start])
}

// ---------------------------------------------------------------------------
// Taegliches Gehalt
//
// Einmal pro KALENDERTAG, nicht alle 24 Stunden: Wer um 23:59 abholt, ist um
// 0:00 wieder dran. Deshalb steht der Tag als "YYYY-MM-DD" (Europe/Berlin) in
// der Zeile statt eines Zeitstempels, gegen den gerechnet wird.
//
// Der Unique-Index ist die eigentliche Sperre, nicht die Pruefung davor: Zwei
// gleichzeitige Klicks laufen so in einen Datenbankfehler statt in zwei
// Auszahlungen.
//
// Jede Zeile ist ausserdem ein Beleg - hier entsteht Geld aus dem Nichts, das
// soll nachvollziehbar bleiben.
// ---------------------------------------------------------------------------

model SalaryClaim {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Kalendertag in Europe/Berlin, "YYYY-MM-DD".
  day String

  /// Ausgezahlt in Spurs, der kleinsten Einheit (siehe lib/currency.ts).
  spurs Int

  /// Auf welches Minecraft-Konto gezahlt wurde. Festgehalten, weil sich die
  /// Verknuepfung am Account spaeter aendern kann - der Beleg soll trotzdem
  /// zeigen, wohin das Geld damals ging.
  minecraftName String
  minecraftUuid String

  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Whitelist-Anträge – werden beim ersten Login automatisch angelegt
// ---------------------------------------------------------------------------

model WhitelistApplication {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  minecraftName String?
  message       String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote    String?
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vorschlags-Board (Mod-Vorschläge, Bugs, Features) mit Upvotes
// ---------------------------------------------------------------------------

model Suggestion {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String // MOD | BUG | FEATURE
  status    String   @default("OPEN") // OPEN | PLANNED | DONE | REJECTED
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes     Vote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Vote {
  userId       String
  suggestionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([userId, suggestionId])
}

// ---------------------------------------------------------------------------
// Shops – Spieler tragen ihren Laden selbst ein und er ist sofort öffentlich
// sichtbar (Numismatics kennt keine globale Shop-Registry, siehe economy-source.ts).
// Keine Freigabe nötig; Admins können Einträge jederzeit entfernen (Moderation).
// ---------------------------------------------------------------------------

model Shop {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sells       String // Komma-getrennte Liste, siehe shop-types.ts
  locationX   Int
  locationZ   Int
  dimension   String   @default("overworld") // overworld | nether | end
  open        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings ShopRating[]

  @@index([createdAt])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Shop-Bewertungen
//
// Eine Bewertung je Person und Laden - der Unique-Index ist die Regel, nicht
// eine Pruefung davor: Wer nochmal bewertet, aendert seine alte Bewertung,
// statt eine zweite Stimme abzugeben.
//
// Der eigene Laden laesst sich nicht bewerten (siehe lib/shops.ts). Der
// Kommentar laeuft durch dieselbe Pruefung wie die Kopfgeld-Begruendung
// (lib/schimpfwoerter.ts) - er steht oeffentlich neben dem Namen des Ladens.
// ---------------------------------------------------------------------------

model ShopRating {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1 bis 5.
  stars Int

  /// Freiwilliger Kommentar, schon entschaerft und geprueft.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, userId])
  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Protokoll aller Konsolenbefehle, die die Website an den Server geschickt hat
// ---------------------------------------------------------------------------

model CommandLog {
  id        String   @id @default(cuid())
  command   String
  reason    String // z. B. "Whitelist angenommen"
  success   Boolean
  error     String?
  /** Discord-Name des auslösenden Admins (nicht als Relation, damit das Protokoll Löschungen überlebt). */
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Protokoll der Server-Steuerung: Start/Stopp aus dem Kontrollraum und alles,
// was der Watchdog beobachtet oder selbst ausgelöst hat (siehe server-watchdog.ts)
// ---------------------------------------------------------------------------

model ServerEvent {
  id      String  @id @default(cuid())
  /// Siehe SERVER_EVENT_TYPES in server-power-types.ts
  type    String
  detail  String?
  success Boolean @default(true)
  /// Discord-Name des Admins; leer = vom Watchdog ausgelöst
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Protokoll der Admin-Eingriffe an einzelnen Spielern.
//
// Getrennt vom CommandLog, weil es eine andere Frage beantwortet: nicht "welcher
// Befehl ging an den Server", sondern "wer hat was mit wem gemacht". Vor allem
// fuer IP-Abfragen wichtig – personenbezogene Daten sollen nachvollziehbar
// bleiben (siehe lib/players.ts).
// ---------------------------------------------------------------------------

model PlayerAudit {
  id String @id @default(cuid())
  /// KICK | BAN | UNBAN | IP_VIEW
  type String
  /// Minecraft-Name des betroffenen Spielers
  target String
  detail String?
  success Boolean @default(true)
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}

// ---------------------------------------------------------------------------
// Server-Einstellungen (im Admin-Panel bearbeitbar, überschreiben die .env-Defaults)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Chat, Befehle und Kommen/Gehen vom Spielserver.
//
// Geliefert vom KubeJS-Skript insights-log.js (siehe minecraft/kubejs/), das
// die Ereignisse als JSON ablegt; die Website holt sie regelmaessig ab
// (lib/game-log.ts). Alles in EINER Tabelle, weil der Kontext einer Nachricht
// spieleruebergreifend ist: „fuenf davor, fuenf danach" ist dann eine Abfrage
// ueber `seq` statt ein Zusammenfuegen mehrerer Tabellen.
// ---------------------------------------------------------------------------

model GameLog {
  /// Fortlaufend in der Reihenfolge des Eintreffens – daran haengt der Kontext.
  seq Int @id @default(autoincrement())

  /// Serverlauf und laufende Nummer darin, beides aus dem KubeJS-Skript.
  /// Zusammen eindeutig: So kann dasselbe Ereignis nicht zweimal in der
  /// Tabelle landen, egal wie oft abgeholt wird. Optional, weil Eintraege
  /// aus Discord (siehe externalId) keins von beidem haben - NULL zaehlt in
  /// einem Unique-Index nie als Duplikat, auch nicht gegen ein zweites NULL.
  runId     String?
  sourceSeq Int?

  /// Discord-Nachrichten-ID (Snowflake, als String - als Zahl verliert
  /// JavaScript ab 2^53 Praezision). Eindeutig fuer sich allein, denn ein
  /// Serverlauf ergibt hier keinen Sinn: Der Discord-Kanal existiert
  /// unabhaengig davon, ob der Minecraft-Server gerade laeuft.
  externalId String?

  /// CHAT | COMMAND | COMMAND_CONSOLE | JOIN | QUIT | DEATH, siehe game-log-types.ts
  kind       String
  playerName String
  playerUuid String?

  /// Verknuepfter Website-Account, falls es einen gibt. Wird beim Abholen
  /// aufgeloest; ohne Treffer bleibt der Name als einzige Zuordnung.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  text String
  /// Zeitpunkt auf dem Spielserver.
  at DateTime

  createdAt DateTime @default(now())

  @@unique([runId, sourceSeq])
  @@unique([externalId])
  @@index([playerName, seq])
  @@index([kind, seq])
  @@index([userId, seq])
  @@index([at])
}
