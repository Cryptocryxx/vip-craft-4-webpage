// VIP Craft 4 – Datenbankschema (SQLite via Prisma 7 + better-sqlite3 Adapter)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) Modelle – siehe https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // VIP Craft spezifisch
  minecraftName String?  @unique
  twitchName    String?  @unique
  whitelisted   Boolean  @default(false)
  role          String   @default("PLAYER") // PLAYER | ADMIN

  /// Ist der Account im Discord-Server? Geprüft über den OAuth-Scope
  /// guilds.members.read, siehe lib/discord.ts
  discordJoined    Boolean   @default(false)
  discordCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  suggestions         Suggestion[]
  votes               Vote[]
  applications        WhitelistApplication[] @relation("Applicant")
  reviewedApplications WhitelistApplication[] @relation("Reviewer")
  shops               Shop[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Whitelist-Anträge – werden beim ersten Login automatisch angelegt
// ---------------------------------------------------------------------------

model WhitelistApplication {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  minecraftName String?
  message       String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote    String?
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vorschlags-Board (Mod-Vorschläge, Bugs, Features) mit Upvotes
// ---------------------------------------------------------------------------

model Suggestion {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String // MOD | BUG | FEATURE
  status    String   @default("OPEN") // OPEN | PLANNED | DONE | REJECTED
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes     Vote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Vote {
  userId       String
  suggestionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([userId, suggestionId])
}

// ---------------------------------------------------------------------------
// Shops – Spieler tragen ihren Laden selbst ein und er ist sofort öffentlich
// sichtbar (Numismatics kennt keine globale Shop-Registry, siehe economy-source.ts).
// Keine Freigabe nötig; Admins können Einträge jederzeit entfernen (Moderation).
// ---------------------------------------------------------------------------

model Shop {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sells       String // Komma-getrennte Liste, siehe shop-types.ts
  locationX   Int
  locationZ   Int
  dimension   String   @default("overworld") // overworld | nether | end
  open        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Protokoll aller Konsolenbefehle, die die Website an den Server geschickt hat
// ---------------------------------------------------------------------------

model CommandLog {
  id        String   @id @default(cuid())
  command   String
  reason    String // z. B. "Whitelist angenommen"
  success   Boolean
  error     String?
  /** Discord-Name des auslösenden Admins (nicht als Relation, damit das Protokoll Löschungen überlebt). */
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Protokoll der Server-Steuerung: Start/Stopp aus dem Kontrollraum und alles,
// was der Watchdog beobachtet oder selbst ausgelöst hat (siehe server-watchdog.ts)
// ---------------------------------------------------------------------------

model ServerEvent {
  id      String  @id @default(cuid())
  /// Siehe SERVER_EVENT_TYPES in server-power-types.ts
  type    String
  detail  String?
  success Boolean @default(true)
  /// Discord-Name des Admins; leer = vom Watchdog ausgelöst
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Protokoll der Admin-Eingriffe an einzelnen Spielern.
//
// Getrennt vom CommandLog, weil es eine andere Frage beantwortet: nicht "welcher
// Befehl ging an den Server", sondern "wer hat was mit wem gemacht". Vor allem
// fuer IP-Abfragen wichtig – personenbezogene Daten sollen nachvollziehbar
// bleiben (siehe lib/players.ts).
// ---------------------------------------------------------------------------

model PlayerAudit {
  id String @id @default(cuid())
  /// KICK | BAN | UNBAN | IP_VIEW
  type String
  /// Minecraft-Name des betroffenen Spielers
  target String
  detail String?
  success Boolean @default(true)
  actorName String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}

// ---------------------------------------------------------------------------
// Server-Einstellungen (im Admin-Panel bearbeitbar, überschreiben die .env-Defaults)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
