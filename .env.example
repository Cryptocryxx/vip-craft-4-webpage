# Kopiere diese Datei nach .env und fülle die Werte aus.

# SQLite-Datenbank (Pfad relativ zum Projekt-Root)
DATABASE_URL="file:./prisma/dev.db"

# Auth.js / NextAuth – Secret erzeugen mit: npx auth secret  (oder: openssl rand -base64 32)
AUTH_SECRET=""
# Discord OAuth App: https://discord.com/developers/applications
# Redirect-URL eintragen: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# PFLICHT in Produktion (ausserhalb von Vercel), sonst schlaegt JEDER Login mit
# "?error=Configuration" fehl und die Weiterleitung landet auf localhost:3000:
# Auth.js traut dem Host-Header nur, wenn eine der beiden Variablen gesetzt ist.
# AUTH_URL="https://vip4.example.de"        (explizit, empfohlen)
# AUTH_TRUST_HOST="true"                    (leitet die Adresse aus den Proxy-Headern ab)

# Admin-Bootstrap: kommagetrennte Discord-User-IDs, die beim Login automatisch
# Admin werden. Bleibt die Liste leer, wird der allererste Login zum Admin.
ADMIN_DISCORD_IDS=""

# Öffentliche Server-Infos (Startwerte – im Admin-Panel überschreibbar)
NEXT_PUBLIC_SERVER_IP="play.vipcraft.de"
NEXT_PUBLIC_MAP_URL="https://vip4.wehrmann.ing/"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/vipcraft"

# Twitch-API fuer den Live-Status der verknuepften Kanaele.
# Anwendung anlegen: https://dev.twitch.tv/console/apps
# OAuth-Redirect-URL dort: http://localhost:3000 (wird nicht genutzt, ist aber Pflichtfeld)
# Ohne diese Werte laeuft die Seite weiter, alle Kanaele gelten dann als offline.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Crafty Controller (Statistiken lesen, Whitelist-Befehle, Server steuern)
# Rolle mit FILES, COMMANDS und LOGS auf genau diesem Server, kein Superuser.
#   FILES    -> Spielerstatistiken lesen
#   COMMANDS -> Whitelist-Befehle UND Start/Stopp/Neustart
#   LOGS     -> Server-Log lesen, damit der Watchdog Absturz von Stopp unterscheiden kann
# Token unter Profil -> API Keys erzeugen. Pruefen mit: npm run crafty:check
CRAFTY_URL="https://game.wehrmann.ing"
CRAFTY_TOKEN=""
CRAFTY_SERVER_ID=""
# Nur setzen, wenn der Weltordner nicht "world" heisst:
# CRAFTY_WORLD_DIR="world"
# Notausgang bei selbstsigniertem Zertifikat (besser: NODE_EXTRA_CA_CERTS):
# CRAFTY_ALLOW_INSECURE_TLS="true"

# Watchdog: beobachtet den Minecraft-Server und startet ihn nach einem Absturz neu.
# NUR auf dem Host einschalten, der die Website dauerhaft betreibt - laufen zwei
# Instanzen (z. B. Entwicklung und Produktivbetrieb) gleichzeitig, starten beide.
# Ob im Ernstfall wirklich neu gestartet wird, schaltet man zusaetzlich im
# Kontrollraum unter "Server-Steuerung" frei.
SERVER_WATCHDOG="false"
# Pruefintervall in Sekunden (15-900, Standard 60):
# SERVER_WATCHDOG_INTERVAL_SECONDS="60"

# Deploy-Webhook (deploy/webhook.mjs) - nur auf dem Produktivhost noetig.
# Secret erzeugen mit: openssl rand -hex 32
# Denselben Wert in GitHub unter Settings -> Webhooks -> Secret eintragen.
# Ohne Wert startet der Webhook-Dienst absichtlich nicht.
DEPLOY_WEBHOOK_SECRET=""
# Vorgaben, nur bei Bedarf aendern:
# DEPLOY_PORT="9000"
# DEPLOY_BRANCH="main"
# DEPLOY_PM2_APP="vipcraft"

# Discord-Server-ID fuer die Mitgliedschaftspruefung beim Whitelist-Antrag
# (Entwicklermodus an -> Rechtsklick auf den Server -> "Server-ID kopieren").
# Braucht den OAuth-Scope guilds.members.read, den src/auth.ts anfragt.
# Leer lassen = Pruefung aus. Der Discord-Schritt steht dann weiterhin in der
# Checkliste, laesst sich aber nicht abhaken – das Team muss von Hand nachsehen.
DISCORD_GUILD_ID=""

# Discord-Bot-Token: prueft die Mitgliedschaft fuer beliebige Accounts, auch
# ohne dass die betreffende Person gerade da ist. Developer Portal -> Bot ->
# Reset Token. Der Bot muss nur auf dem Server sein: keine Rechte noetig
# (permissions=0), kein privilegiertes Intent - wir fragen gezielt nach einer
# Discord-ID und holen nicht die Mitgliederliste.
# Fehlt er, faellt die Pruefung auf die persoenlichen OAuth-Tokens zurueck.
DISCORD_BOT_TOKEN=""

# Discord-Kanal, der per DiscordLinker (oder aehnlichem Mod) mit dem
# Minecraft-Chat verbunden ist - Nachrichten von dort landen mit im
# Chatverlauf des Kontrollraums (siehe lib/discord-chat.ts).
# Kanal-ID: Entwicklermodus an -> Rechtsklick auf den Kanal -> "Kanal-ID kopieren".
# Braucht zusaetzlich zum Bot-Token oben:
#   1. Developer Portal -> Bot -> "Message Content Intent" einschalten
#      (kostenloses Haekchen, sonst kommt jede Nachricht mit leerem Text an).
#   2. Dem Bot in genau diesem Kanal "Kanal anzeigen" und "Nachrichtenverlauf
#      anzeigen" erlauben.
# Leer lassen = aus, dann bleibt nur der Chat aus dem Spiel selbst.
DISCORD_CHAT_CHANNEL_ID=""
